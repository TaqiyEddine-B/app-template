{
    "name": "AppTemplate Container",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
    "shutdownAction": "stopContainer",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "mhutchie.git-graph",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "containerEnv": {
        "PYTHONUNBUFFERED": "True",
        "UV_LINK_MODE": "copy",
        "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
    },
    "remoteUser": "vscode",
    "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && make setup && make install"
}